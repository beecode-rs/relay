  "scripts": {
    "android-release": "pnpm run android -- --variant release",
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android-rebuild": "expo prebuild -p android --clean && pnpm run android",
    "build:android-release": "expo prebuild -p android --clean --no-install && node scripts/patch-android-build.mjs && cd android && ./gradlew assembleRelease -x lintVitalAnalyzeRelease -x lintVitalReportRelease",
